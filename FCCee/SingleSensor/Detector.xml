		<constant name="world_z" value="world_size"/>
	</define>

	<include ref="VertexComplete_IDEA_o1_v03.xml"/>

	<plugins>
		<plugin name="DD4hepVolumeManager"/>
		<plugin name="InstallSurfaceManager"/>
	</plugins>

